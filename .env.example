# Copy to .env and fill in. .env is gitignored — never commit it.
# Test keys look like sk_test_… / pk_test_… . Never put a live key here.

# Secret key. Prefer a RESTRICTED key (rk_test_…) limited to:
#   Checkout Sessions: write · Webhook Endpoints: read · Products/Prices: read
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key — safe to expose, it is sent to the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe sends the customer back to.
PUBLIC_URL=http://localhost:8080
