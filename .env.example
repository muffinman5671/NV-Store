# Copy to .env and fill in. .env is gitignored — never commit it.
# Test keys look like sk_test_… / pk_test_… . Never put a live key here.

# Secret key. Prefer a RESTRICTED key (rk_test_…) limited to:
#   Checkout Sessions: write · Webhook Endpoints: read · Products/Prices: read
#   Charges: read · Invoices: read · PaymentIntents: write
# The last three are for receipts. Without PaymentIntents write the receipt
# still renders on the site, but Stripe sends no receipt email.
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key — safe to expose, it is sent to the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Stripe sends the customer back to. Must be the real public https://
# origin once deployed — a wrong value returns paying customers to nowhere.
# Production is https://nv-store.store (domain registered at IONOS).
# While testing on Render, set it to the temporary onrender.com URL first.
PUBLIC_URL=http://localhost:8080


# ---------------------------------------------------------------- deployment
# Only needed when hosting. Locally the defaults are correct and you can
# ignore everything below.

# Makes the admin session cookie Secure. Set it on any host serving over
# https, and leave it unset locally or the cookie will not survive http.
#NODE_ENV=production

# Where runtime data lives: catalogue.json, orders.json, admin.json.
# Point this at a mounted volume when deploying. Hosted platforms have an
# ephemeral filesystem that is wiped on every deploy and restart, which
# without this would discard the orders taken since the last push.
# The catalogue is seeded onto an empty volume automatically on first boot.
#NV_DATA_DIR=/var/data

# Admin credential as "<saltHex>:<hashHex>", used instead of admin.json.
# admin.json is gitignored and cannot be written to an ephemeral filesystem,
# so a fresh deploy would otherwise have no password at all.
# Generate with:  node server/set-password.js --print
#NV_ADMIN_HASH=

# Used by the test suite to keep scratch orders away from the real file.
# Nothing else should set it.
#NV_ORDERS_FILE=
